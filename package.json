{
  "name": "bht-nexus-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate:config": "node scripts/validate-github-config.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run validate:config && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
