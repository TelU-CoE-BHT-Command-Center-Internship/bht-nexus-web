# Salin menjadi .env.local lalu sesuaikan dengan server yang dipakai.

# Alamat API bht-nexus-server yang dipanggil browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Opsional: alamat API untuk permintaan dari server Next.js bila jalurnya
# berbeda dari browser, misalnya ketika web dan API berada di container berbeda.
# API_INTERNAL_BASE_URL=http://localhost:3000/api

# Opsional: bila web dan API berada di alamat berbeda, misalnya web di hosting
# publik dan API di balik tunnel, isi alamat dasar server (tanpa /api) di sini
# dan setel NEXT_PUBLIC_API_BASE_URL=/api. Permintaan /api/* kemudian diteruskan
# oleh web sehingga cookie sesi berada di alamat web.
# API_PROXY_TARGET=https://alamat-server.example
