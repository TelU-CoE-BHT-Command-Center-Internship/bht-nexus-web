# Salin menjadi .env.local untuk pengembangan lokal. Jangan menyimpan .env.local ke Git.

# Alamat bht-nexus-server yang melayani /api, tanpa garis miring di akhir.
# Hanya dibaca di server Next.js: browser memanggil /api/* pada alamat web yang
# sama, lalu proxy meneruskannya ke alamat ini agar cookie sesi tetap first-party.
BHT_NEXUS_API_ORIGIN=http://localhost:3001
